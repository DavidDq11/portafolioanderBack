# Puerto del servidor (Render asigna PORT automáticamente en producción)
PORT=3000

# Cadena de conexión de PostgreSQL en Neon.tech
# Ejemplo: postgresql://usuario:password@ep-xxxx-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://usuario:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Clave secreta para firmar los tokens JWT del panel administrador
JWT_SECRET=cambia_esta_clave_por_una_secreta_y_larga_2026

# Opcional: lista de orígenes extra permitidos por CORS separados por coma
# Ejemplo: https://tu-dominio.com,https://tu-app.vercel.app
CORS_ORIGIN=
